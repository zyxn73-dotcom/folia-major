{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": [
    {
      "name": "frontend",
      "source": "./frontend",
      "public": true,
      "rewrite": {
        "source": "/(.*)",
        "destination": "/$1"
      }
    },
    {
      "name": "backend",
      "source": "./backend",
      "public": false
    }
  ],
  "bindings": [
    {
      "from": "frontend",
      "to": "backend",
      "variable": "API_BASE"
    }
  ]
}
